# Remplace office.glowupagence.fr par ton sous-domaine réel
office.glowupagence.fr {
	encode gzip

	header {
		# Non indexé (moteurs de recherche)
		X-Robots-Tag "noindex, nofollow, noarchive"
		# OnlyOffice iframe depuis l’app
		Content-Security-Policy "frame-ancestors https://app.glowupagence.fr http://localhost:3000"
		-Server
	}

	handle /robots.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "User-agent: *\nDisallow: /\n" 200
	}

	handle {
		reverse_proxy onlyoffice:80
	}
}
